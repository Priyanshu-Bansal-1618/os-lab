--- /dev/null	2026-10-13 10:19:40.116100294 +0000
+++ asg8/q1-va2pa/vatest.c	2026-10-13 10:21:17.304781500 +0000
@@ -0,0 +1,30 @@
+#include "types.h"
+#include "stat.h"
+#include "user.h"
+
+int globalvar = 42;
+
+int
+main(void)
+{
+  int localvar = 7;
+  void *heap = malloc(64);
+  int pid;
+
+  printf(1, "== parent pid %d ==\n", getpid());
+  printf(1, "global: va=%x pa=%x\n", (int)&globalvar, va2pa((int)&globalvar));
+  printf(1, "local : va=%x pa=%x\n", (int)&localvar, va2pa((int)&localvar));
+  printf(1, "heap  : va=%x pa=%x\n", (int)heap, va2pa((int)heap));
+  printf(1, "unmapped 0x7fffffff -> %d (expect -1)\n", va2pa(0x7FFFFFFF));
+
+  pid = fork();
+  if(pid == 0){
+    printf(1, "== child pid %d ==\n", getpid());
+    printf(1, "child  global: va=%x pa=%x\n", (int)&globalvar, va2pa((int)&globalvar));
+    exit();
+  }
+  printf(1, "parent global: va=%x pa=%x\n", (int)&globalvar, va2pa((int)&globalvar));
+  wait();
+  printf(1, "same VA but different PA in parent/child => fork copies pages\n");
+  exit();
+}
