+
+// pages used by a process's page tables:
+// 1 (the directory page) + one per present PDE (a page-table page)
+int
+count_pt_pages(pde_t *pgdir)
+{
+  int i, n = 1;
+  for(i = 0; i < NPDENTRIES; i++)
+    if(pgdir[i] & PTE_P)
+      n++;
+  return n;
+}
+
+// Asg8 Q4: fault in one lazy heap page for the current process.
+// Returns 0 on success (page now mapped PTE_W|PTE_U, zeroed), -1 if the
+// address is invalid (>= sz, guard page, already-present-but-not-user,
+// or kalloc failed).
+int
+lazyalloc(uint va)
+{
+  struct proc *cur = myproc();
+  pte_t *pte;
+  char *mem;
+
+  if(cur == 0 || va >= cur->sz)
+    return -1;
+  pte = walkpgdir(cur->pgdir, (void*)va, 0);
+  if(pte && (*pte & PTE_P)){
+    if(*pte & PTE_U)
+      return 0;            // already there (e.g. stack/text)
+    return -1;             // guard page: mapped but U cleared
+  }
+  mem = kalloc();
+  if(mem == 0)
+    return -1;             // out of physical memory
+  memset(mem, 0, PGSIZE);
+  if(mappages(cur->pgdir, (char*)PGROUNDDOWN(va), PGSIZE,
+              V2P(mem), PTE_W|PTE_U) < 0){
+    kfree(mem);
+    return -1;
+  }
+  return 0;
+}
